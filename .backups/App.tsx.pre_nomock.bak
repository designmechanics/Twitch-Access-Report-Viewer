import React, { useState } from 'react';
import { Header } from './components/Header';
import { ZipDropzone } from './components/ZipDropzone';
import { FileTreeSidebar } from './components/FileTreeSidebar';
import { ReportViewer } from './components/ReportViewer';
import { FileTreeNode, ZipFileEntry, TwitchReportStats } from './types';
import { parseTwitchZip } from './utils/zipParser';
import { generateSampleTwitchZip } from './utils/sampleData';

export default function App() {
  const [tree, setTree] = useState<FileTreeNode[]>([]);
  const [entries, setEntries] = useState<ZipFileEntry[]>([]);
  const [stats, setStats] = useState<TwitchReportStats | null>(null);
  const [selectedFile, setSelectedFile] = useState<ZipFileEntry | null>(null);
  const [archiveName, setArchiveName] = useState<string | null>(null);
  const [archiveHash, setArchiveHash] = useState<string>('8F2A...E412');
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const processZip = async (fileOrBlob: File | Blob, name?: string) => {
    try {
      setIsLoading(true);
      setError(null);

      const parsed = await parseTwitchZip(fileOrBlob);
      setEntries(parsed.entries);
      setTree(parsed.tree);
      setStats(parsed.stats);
      setArchiveName(name || (fileOrBlob instanceof File ? fileOrBlob.name : 'twitch_data_export.zip'));

      // Generate a clean pseudo-hash for report audit tracking
      const randomHex = Array.from({ length: 4 }, () =>
        Math.floor((1 + Math.random()) * 0x10000)
          .toString(16)
          .substring(1)
          .toUpperCase()
      ).join('');
      setArchiveHash(`${randomHex.slice(0, 4)}...${randomHex.slice(12, 16)}`);

      const priorityOrder = [
        'account_information/user_details.json',
        'chat/chat_messages.csv',
        'viewership/minutes_watched.csv',
        'financials/subscriptions.csv',
        'financials/bits_cheers.csv'
      ];

      let defaultSelection = parsed.entries.find((e) =>
        priorityOrder.some((p) => e.path.toLowerCase().includes(p.toLowerCase()))
      );

      if (!defaultSelection && parsed.entries.length > 0) {
        defaultSelection = parsed.entries[0];
      }

      setSelectedFile(defaultSelection || null);
    } catch (err: any) {
      console.error(err);
      setError(err.message || 'Failed to extract and read Twitch .zip archive.');
    } finally {
      setIsLoading(false);
    }
  };

  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    if (e.target.files && e.target.files[0]) {
      const file = e.target.files[0];
      processZip(file, file.name);
    }
  };

  const handleFileDrop = (file: File) => {
    processZip(file, file.name);
  };

  const handleLoadSample = async () => {
    try {
      setIsLoading(true);
      const sampleBlob = await generateSampleTwitchZip();
      await processZip(sampleBlob, 'twitch_data_2026.zip');
    } catch (err: any) {
      console.error(err);
      setError('Failed to generate sample archive.');
      setIsLoading(false);
    }
  };

  const handleReset = () => {
    setTree([]);
    setEntries([]);
    setStats(null);
    setSelectedFile(null);
    setArchiveName(null);
    setError(null);
  };

  return (
    <div className="flex h-screen w-full flex-col bg-[#0F0E11] font-sans text-gray-200 overflow-hidden select-none">
      <Header
        stats={stats}
        currentFileName={selectedFile?.name || null}
        archiveName={archiveName}
        onFileUpload={handleFileUpload}
        onLoadSample={handleLoadSample}
        onReset={handleReset}
        isLoading={isLoading}
      />

      {error && (
        <div className="bg-rose-950/50 border-b border-rose-900 px-6 py-2 text-xs text-rose-300 flex items-center justify-between font-mono">
          <span>{error}</span>
          <button
            onClick={() => setError(null)}
            className="cursor-pointer text-rose-400 hover:text-white font-bold ml-4"
          >
            ✕
          </button>
        </div>
      )}

      {/* Main Container */}
      <main className="flex flex-1 overflow-hidden">
        {stats && tree.length > 0 ? (
          <>
            <FileTreeSidebar
              tree={tree}
              selectedFile={selectedFile}
              onSelectFile={setSelectedFile}
              categories={stats.categories}
            />
            <ReportViewer
              selectedFile={selectedFile}
              archiveName={archiveName}
            />
          </>
        ) : (
          <div className="flex-1 flex items-center justify-center p-6 bg-[#0F0E11]">
            <ZipDropzone
              onFileDrop={handleFileDrop}
              onLoadSample={handleLoadSample}
              isLoading={isLoading}
            />
          </div>
        )}
      </main>

      {/* Professional Polish Footer */}
      <footer className="flex h-10 w-full items-center justify-between border-t border-white/10 bg-[#121214] px-6 text-[10px] text-gray-500 uppercase tracking-widest shrink-0 font-mono">
        <div>Processing Session: X99-B02-FF4</div>
        <div className="flex items-center gap-4">
          <span>Format: Twitch GDPR / CCPA Access Report</span>
          <span>Archive Hash: {archiveHash}</span>
        </div>
      </footer>
    </div>
  );
}
